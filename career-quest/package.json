{
  "name": "career-quest",
  "type": "module",
  "private": true,
  "slidev": {
    "highlighter": "shiki",
    "shiki": {
      "theme": "dark-plus"
    }
  },
  "scripts": {
    "dev": "slidev",
    "build": "slidev build --base /slidev-presentations/career-quest/ && cp public/404.html dist/404.html",
    "export": "slidev export",
    "deploy": "npm run build && npx gh-pages -d dist -e career-quest"
  },
  "dependencies": {
    "@slidev/cli": "^52.9.1",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "latest",
    "d3-geo": "^3.1.1",
    "three": "^0.160.0",
    "topojson-client": "^3.1.0",
    "vue": "^3.5.24",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "playwright-chromium": "^1.63.0"
  }
}
